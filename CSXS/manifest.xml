<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" 
                   ExtensionBundleId="com.kuttipencil.extension" 
                   ExtensionBundleVersion="1.0.0" 
                   ExtensionBundleName="Kutti Pencil" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.kuttipencil.extension.panel" Version="1.0.0" />
    </ExtensionList>
    
    <ExecutionEnvironment>
        <HostList>
            <!-- Photoshop Support (CS6 through CC 2024+) -->
            <Host Name="PHSP" Version="[13.0,99.9]" />
            <Host Name="PHXS" Version="[13.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    
    <DispatchInfoList>
        <Extension Id="com.kuttipencil.extension.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Kutti Pencil</Menu>
                    <Geometry>
                        <Size>
                            <Width>300</Width>
                            <Height>480</Height>
                        </Size>
                        <MinSize>
                            <Width>240</Width>
                            <Height>320</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>600</Width>
                            <Height>1200</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
